# GitHub Token（可选，提高 API 速率限制：未认证 60次/小时，认证 5000次/小时）
# 在 https://github.com/settings/tokens 创建 Personal Access Token（只需 public_repo 权限）
GITHUB_TOKEN=

# AI 摘要生成（可选，用于生成项目中文简介）
# 兼容 OpenAI API 格式，推荐使用 SiliconFlow（免费额度充足）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=Qwen/Qwen2.5-7B-Instruct

# 采集配置
# 每日目标采集项目数量
DAILY_TARGET=20
# 采集的编程语言（逗号分隔，留空则采集所有语言）
LANGUAGES=python,javascript,typescript,go,rust,java,cpp,c
# 时间范围：daily（每日）/ weekly（每周）/ monthly（每月）
SINCE=daily

# 请求间隔（秒），避免触发限速
REQUEST_INTERVAL=1
# AI 摘要最大重试次数
MAX_RETRY=3
